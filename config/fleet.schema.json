{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnchoredAisle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/AnchoredRect"
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ],
          "title": "Axis",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "main",
                "cross",
                "access"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "id",
        "label",
        "bounds",
        "axis"
      ],
      "title": "AnchoredAisle",
      "type": "object"
    },
    "AnchoredDock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/AnchoredPose"
        },
        "tolerance_radius": {
          "description": "Dock contact region radius, metres.",
          "exclusiveMinimum": 0,
          "title": "Tolerance Radius",
          "type": "number"
        }
      },
      "required": [
        "id",
        "pose",
        "tolerance_radius"
      ],
      "title": "AnchoredDock",
      "type": "object"
    },
    "AnchoredFleetConfig": {
      "additionalProperties": false,
      "properties": {
        "fleet": {
          "$ref": "#/$defs/Fleet"
        },
        "robots": {
          "items": {
            "$ref": "#/$defs/AnchoredRobot"
          },
          "title": "Robots",
          "type": "array"
        },
        "stations": {
          "$ref": "#/$defs/AnchoredStations"
        },
        "policies": {
          "$ref": "#/$defs/Policies"
        },
        "warehouse": {
          "$ref": "#/$defs/WarehouseSource"
        }
      },
      "required": [
        "fleet",
        "robots",
        "stations",
        "policies",
        "warehouse"
      ],
      "title": "AnchoredFleetConfig",
      "type": "object"
    },
    "AnchoredPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[WE]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[SN]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "Y"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "AnchoredPoint",
      "type": "object"
    },
    "AnchoredPose": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[WE]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[SN]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw"
      ],
      "title": "AnchoredPose",
      "type": "object"
    },
    "AnchoredRack": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/AnchoredRect"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "bays": {
          "maximum": 12,
          "minimum": 1,
          "title": "Bays",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "bounds",
        "height",
        "bays"
      ],
      "title": "AnchoredRack",
      "type": "object"
    },
    "AnchoredRect": {
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[WE]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "X Min"
        },
        "x_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[WE]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "X Max"
        },
        "y_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[SN]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "Y Min"
        },
        "y_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^[SN]([+-][0-9]+(\\.[0-9]+)?)?$",
              "type": "string"
            }
          ],
          "title": "Y Max"
        }
      },
      "required": [
        "x_min",
        "x_max",
        "y_min",
        "y_max"
      ],
      "title": "AnchoredRect",
      "type": "object"
    },
    "AnchoredRobot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Namespace",
          "type": "string"
        },
        "initial_pose": {
          "$ref": "#/$defs/AnchoredPose"
        },
        "battery_model": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Battery Model",
          "type": "string"
        },
        "nav2_action_name": {
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Nav2 Action Name",
          "type": "string"
        },
        "nav2_params_path": {
          "description": "Nav2 template path relative to fleet YAML.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Nav2 Params Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "namespace",
        "initial_pose",
        "battery_model",
        "nav2_action_name",
        "nav2_params_path"
      ],
      "title": "AnchoredRobot",
      "type": "object"
    },
    "AnchoredStation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/AnchoredPose"
        }
      },
      "required": [
        "id",
        "pose"
      ],
      "title": "AnchoredStation",
      "type": "object"
    },
    "AnchoredStations": {
      "additionalProperties": false,
      "properties": {
        "charging_stations": {
          "items": {
            "$ref": "#/$defs/AnchoredDock"
          },
          "title": "Charging Stations",
          "type": "array"
        },
        "parking_stations": {
          "items": {
            "$ref": "#/$defs/AnchoredStation"
          },
          "title": "Parking Stations",
          "type": "array"
        },
        "safe_waiting_areas": {
          "items": {
            "$ref": "#/$defs/AnchoredStation"
          },
          "title": "Safe Waiting Areas",
          "type": "array"
        }
      },
      "required": [
        "charging_stations",
        "parking_stations",
        "safe_waiting_areas"
      ],
      "title": "AnchoredStations",
      "type": "object"
    },
    "AnchoredTransfer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pickup",
            "dropoff"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/AnchoredPose"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zone Id"
        },
        "rack_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rack Id"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "pickup",
                  "dropoff"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Roles"
        }
      },
      "required": [
        "id",
        "kind",
        "pose"
      ],
      "title": "AnchoredTransfer",
      "type": "object"
    },
    "AnchoredZone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/AnchoredRect"
        },
        "kind": {
          "enum": [
            "pickup",
            "dropoff",
            "charging",
            "parking"
          ],
          "title": "Kind",
          "type": "string"
        },
        "callout": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnchoredPoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "bounds",
        "kind"
      ],
      "title": "AnchoredZone",
      "type": "object"
    },
    "BatteryModel": {
      "additionalProperties": false,
      "properties": {
        "usable_capacity_wh": {
          "exclusiveMinimum": 0,
          "title": "Usable Capacity Wh",
          "type": "number"
        },
        "consumption_wh_per_meter": {
          "exclusiveMinimum": 0,
          "title": "Consumption Wh Per Meter",
          "type": "number"
        },
        "idle_power_w": {
          "minimum": 0,
          "title": "Idle Power W",
          "type": "number"
        },
        "charge_power_w": {
          "exclusiveMinimum": 0,
          "title": "Charge Power W",
          "type": "number"
        }
      },
      "required": [
        "usable_capacity_wh",
        "consumption_wh_per_meter",
        "idle_power_w",
        "charge_power_w"
      ],
      "title": "BatteryModel",
      "type": "object"
    },
    "ChargingStation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "tolerance_radius": {
          "description": "Dock contact region radius, metres.",
          "exclusiveMinimum": 0,
          "title": "Tolerance Radius",
          "type": "number"
        }
      },
      "required": [
        "id",
        "pose",
        "tolerance_radius"
      ],
      "title": "ChargingStation",
      "type": "object"
    },
    "ExampleTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "pickup": {
          "title": "Pickup",
          "type": "string"
        },
        "dropoff": {
          "title": "Dropoff",
          "type": "string"
        },
        "priority": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pickup",
        "dropoff",
        "priority"
      ],
      "title": "ExampleTask",
      "type": "object"
    },
    "Fleet": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "map_path": {
          "description": "Map YAML relative to this file, or 'warehouse:generated'.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Map Path",
          "type": "string"
        },
        "use_sim_time": {
          "const": true,
          "title": "Use Sim Time",
          "type": "boolean"
        },
        "battery_models": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/BatteryModel"
            }
          },
          "title": "Battery Models",
          "type": "object"
        }
      },
      "required": [
        "name",
        "map_path",
        "use_sim_time",
        "battery_models"
      ],
      "title": "Fleet",
      "type": "object"
    },
    "FleetConfig": {
      "additionalProperties": false,
      "properties": {
        "fleet": {
          "$ref": "#/$defs/Fleet"
        },
        "robots": {
          "items": {
            "$ref": "#/$defs/Robot"
          },
          "minItems": 1,
          "title": "Robots",
          "type": "array"
        },
        "stations": {
          "$ref": "#/$defs/Stations"
        },
        "policies": {
          "$ref": "#/$defs/Policies"
        },
        "warehouse": {
          "anyOf": [
            {
              "$ref": "#/$defs/WarehouseLayout"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "fleet",
        "robots",
        "stations",
        "policies"
      ],
      "title": "FleetConfig",
      "type": "object"
    },
    "MapPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "MapPoint",
      "type": "object"
    },
    "MapRectangle": {
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "MapRectangle",
      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "const": "priority_fifo_nearest_eligible",
          "title": "Assignment",
          "type": "string"
        },
        "preemption_priority": {
          "const": "HIGH",
          "title": "Preemption Priority",
          "type": "string"
        },
        "max_preemptions": {
          "const": 2,
          "title": "Max Preemptions",
          "type": "integer"
        },
        "extra_swap_enabled": {
          "const": false,
          "title": "Extra Swap Enabled",
          "type": "boolean"
        },
        "automatic_retry": {
          "const": false,
          "title": "Automatic Retry",
          "type": "boolean"
        },
        "automatic_reassignment": {
          "const": false,
          "title": "Automatic Reassignment",
          "type": "boolean"
        },
        "charge_target_soc_percent": {
          "const": 80,
          "title": "Charge Target Soc Percent",
          "type": "integer"
        },
        "charge_queue": {
          "const": "lowest_soc_fifo",
          "title": "Charge Queue",
          "type": "string"
        },
        "emergency_soc_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Emergency Soc Percent",
          "type": "number"
        },
        "low_soc_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Low Soc Percent",
          "type": "number"
        },
        "safety_margin_wh": {
          "minimum": 0,
          "title": "Safety Margin Wh",
          "type": "number"
        }
      },
      "required": [
        "assignment",
        "preemption_priority",
        "max_preemptions",
        "extra_swap_enabled",
        "automatic_retry",
        "automatic_reassignment",
        "charge_target_soc_percent",
        "charge_queue",
        "emergency_soc_percent",
        "low_soc_percent",
        "safety_margin_wh"
      ],
      "title": "Policies",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "description": "X position in map frame, metres.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Y position in map frame, metres.",
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "description": "Heading in map frame, radians.",
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw"
      ],
      "title": "Pose",
      "type": "object"
    },
    "Robot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Namespace",
          "type": "string"
        },
        "initial_pose": {
          "$ref": "#/$defs/Pose"
        },
        "battery_model": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Battery Model",
          "type": "string"
        },
        "nav2_action_name": {
          "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Nav2 Action Name",
          "type": "string"
        },
        "nav2_params_path": {
          "description": "Nav2 template path relative to fleet YAML.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Nav2 Params Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "namespace",
        "initial_pose",
        "battery_model",
        "nav2_action_name",
        "nav2_params_path"
      ],
      "title": "Robot",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        }
      },
      "required": [
        "id",
        "pose"
      ],
      "title": "Station",
      "type": "object"
    },
    "Stations": {
      "additionalProperties": false,
      "properties": {
        "charging_stations": {
          "items": {
            "$ref": "#/$defs/ChargingStation"
          },
          "minItems": 1,
          "title": "Charging Stations",
          "type": "array"
        },
        "parking_stations": {
          "items": {
            "$ref": "#/$defs/Station"
          },
          "title": "Parking Stations",
          "type": "array"
        },
        "safe_waiting_areas": {
          "items": {
            "$ref": "#/$defs/Station"
          },
          "title": "Safe Waiting Areas",
          "type": "array"
        }
      },
      "required": [
        "charging_stations",
        "parking_stations",
        "safe_waiting_areas"
      ],
      "title": "Stations",
      "type": "object"
    },
    "TransferPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pickup",
            "dropoff"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/TransferPose"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zone Id"
        },
        "rack_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rack Id"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "pickup",
                  "dropoff"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
