{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage B AMCL Test Configuration Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "robot",
    "map_path",
    "nav2_parameters",
    "sensor",
    "room",
    "initial_offset",
    "drive_test",
    "check"
  ],
  "properties": {
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "initial_pose"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "initial_pose": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "number" }
        }
      }
    },
    "map_path": { "type": "string", "pattern": "^/.*\\.(yaml|yml)$" },
    "nav2_parameters": { "type": "string", "pattern": "^/.*\\.(yaml|yml)$" },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pose",
        "samples",
        "min_angle_rad",
        "max_angle_rad",
        "min_range_m",
        "max_range_m",
        "resolution_m",
        "update_rate_hz"
      ],
      "properties": {
        "pose": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "number" }
        },
        "samples": { "type": "integer", "minimum": 16, "maximum": 2048 },
        "min_angle_rad": { "type": "number" },
        "max_angle_rad": { "type": "number" },
        "min_range_m": { "type": "number", "exclusiveMinimum": 0 },
        "max_range_m": { "type": "number", "exclusiveMinimum": 0 },
        "resolution_m": { "type": "number", "exclusiveMinimum": 0 },
        "update_rate_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_m", "wall_thickness_m", "wall_height_m"],
      "properties": {
        "size_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "wall_thickness_m": { "type": "number", "exclusiveMinimum": 0 },
        "wall_height_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "initial_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_offset_m", "y_offset_m", "yaw_offset_rad"],
      "properties": {
        "x_offset_m": { "type": "number" },
        "y_offset_m": { "type": "number" },
        "yaw_offset_rad": { "type": "number" }
      }
    },
    "drive_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linear_vel_mps", "angular_vel_radps", "duration_seconds"],
      "properties": {
        "linear_vel_mps": { "type": "number" },
        "angular_vel_radps": { "type": "number" },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amcl_tolerance_m", "minimum_initial_error_m", "minimum_scan_messages"],
      "properties": {
        "amcl_tolerance_m": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_initial_error_m": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_scan_messages": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
