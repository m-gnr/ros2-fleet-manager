{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulationC23Config",
  "type": "object",
  "required": [
    "robot",
    "map_path",
    "nav2_template_path",
    "sensor",
    "room",
    "goals",
    "check"
  ],
  "additionalProperties": false,
  "properties": {
    "robot": {
      "type": "object",
      "required": ["name", "namespace", "initial_pose", "odom_frame", "base_frame"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z0-9_]+$"},
        "namespace": {"type": "string", "pattern": "^[a-zA-Z0-9_]+$"},
        "initial_pose": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 6,
          "maxItems": 6
        },
        "odom_frame": {"type": "string"},
        "base_frame": {"type": "string"}
      }
    },
    "map_path": {"type": "string"},
    "nav2_template_path": {"type": "string"},
    "sensor": {
      "type": "object",
      "required": [
        "pose",
        "samples",
        "min_angle_rad",
        "max_angle_rad",
        "min_range_m",
        "max_range_m",
        "resolution_m",
        "update_rate_hz"
      ],
      "additionalProperties": false,
      "properties": {
        "pose": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 6,
          "maxItems": 6
        },
        "samples": {"type": "integer", "minimum": 1},
        "min_angle_rad": {"type": "number"},
        "max_angle_rad": {"type": "number"},
        "min_range_m": {"type": "number", "minimum": 0.0},
        "max_range_m": {"type": "number", "minimum": 0.0},
        "resolution_m": {"type": "number", "minimum": 0.0},
        "update_rate_hz": {"type": "number", "minimum": 0.0}
      }
    },
    "room": {
      "type": "object",
      "required": ["size_m", "wall_thickness_m", "wall_height_m"],
      "additionalProperties": false,
      "properties": {
        "size_m": {
          "type": "array",
          "items": {"type": "number", "minimum": 0.0},
          "minItems": 2,
          "maxItems": 2
        },
        "wall_thickness_m": {"type": "number", "minimum": 0.0},
        "wall_height_m": {"type": "number", "minimum": 0.0}
      }
    },
    "goals": {
      "type": "object",
      "required": ["xy_tolerance_m", "yaw_tolerance_rad", "timeout_seconds"],
      "additionalProperties": false,
      "properties": {
        "xy_tolerance_m": {"type": "number", "minimum": 0.0},
        "yaw_tolerance_rad": {"type": "number", "minimum": 0.0},
        "timeout_seconds": {"type": "number", "minimum": 0.0}
      }
    },
    "check": {
      "type": "object",
      "required": [
        "amcl_tolerance_m",
        "minimum_scan_messages"
      ],
      "additionalProperties": false,
      "properties": {
        "amcl_tolerance_m": {"type": "number", "minimum": 0.0},
        "minimum_scan_messages": {"type": "integer", "minimum": 1}
      }
    }
  }
}
