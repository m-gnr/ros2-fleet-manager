{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["robot", "map_path", "nav2_parameters", "probe"],
  "properties": {
    "robot": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "namespace", "initial_pose"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "namespace": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "initial_pose": {"description": "x y z in metres, roll pitch yaw in radians", "type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}
      }
    },
    "map_path": {"description": "Stage A has no map server; must remain null", "type": "null"},
    "nav2_parameters": {"description": "Stage A has no Nav2; must remain null", "type": "null"},
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["linear_velocity_mps", "drive_seconds", "minimum_distance_m", "maximum_distance_m", "settle_seconds"],
      "properties": {
        "linear_velocity_mps": {"type": "number", "exclusiveMinimum": 0},
        "drive_seconds": {"type": "number", "exclusiveMinimum": 0},
        "minimum_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "settle_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
