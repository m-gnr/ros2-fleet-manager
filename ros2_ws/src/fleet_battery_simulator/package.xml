<?xml version="1.0"?>
<package format="3">
  <name>fleet_battery_simulator</name>
  <version>0.1.0</version>
  <description>Simulation-time battery energy accounting for ROS 2 Fleet Manager</description>
  <maintainer email="maintainer@example.com">Fleet Maintainer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>fleet_interfaces</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
